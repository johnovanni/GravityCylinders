<Window x:Class="GravityCylinders.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GravityCylinders"
        Title="Gravity Cylinders" Width="1400" Height="820" WindowState="Maximized" Background="#FF14171C" Foreground="#FFDDE2EA">
    <Window.Resources>
        <local:DisplayNameConverter x:Key="DisplayName" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDE2EA" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8FA3BF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF1E232B" />
            <Setter Property="Foreground" Value="#FFDDE2EA" />
            <Setter Property="BorderBrush" Value="#FF2F3642" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF1E232B" />
            <Setter Property="Foreground" Value="#FFDDE2EA" />
            <Setter Property="BorderBrush" Value="#FF2F3642" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDDE2EA" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#FF181C22">
            <StackPanel Margin="14">
                <TextBlock Text="Preset" Style="{StaticResource Header}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedIndex="{Binding PresetIndex}" />

                <TextBlock Text="Model" Style="{StaticResource Header}" />
                <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Frame" Style="{StaticResource Header}" />
                <ListBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource DisplayName}}" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Cylinders (lab-frame speeds)" Style="{StaticResource Header}" />
                <ItemsControl ItemsSource="{Binding Cylinders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF2F3642" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock Grid.Row="1" Text="λ (kg/m)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Lambda, StringFormat={}{0:G4}}" />
                                    <TextBlock Grid.Row="2" Text="Length (m)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Length}" />
                                    <TextBlock Grid.Row="3" Text="Radius (m)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Radius}" />
                                    <TextBlock Grid.Row="4" Text="y (m)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Y}" />
                                    <TextBlock Grid.Row="5" Text="β (v/c)" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Beta, StringFormat=0.###}" />
                                    <Slider Grid.Row="6" Grid.ColumnSpan="2" Minimum="-0.99" Maximum="0.99" Value="{Binding Beta}"
                                            SmallChange="0.01" LargeChange="0.1" Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#FFFFB020" TextWrapping="Wrap" />

                <TextBlock Text="Display" Style="{StaticResource Header}" />
                <CheckBox Content="Arrow length shows force strength" IsChecked="{Binding ArrowLengthShowsStrength}" />
                <TextBlock Text="Arrow size" />
                <Slider Minimum="0.3" Maximum="3" Value="{Binding ArrowScale}" />
                <TextBlock Text="Ring animation speed" />
                <Slider Minimum="0" Maximum="5" Value="{Binding TimeScale}" />
                <TextBlock Text="Left-drag rotate · right-drag pan · wheel zoom" Foreground="#FF8FA3BF" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 3D view and HUD -->
            <Border x:Name="ViewportHost" Background="Transparent" Focusable="True">
                <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="False">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="Camera" FieldOfView="45" />
                    </Viewport3D.Camera>
                </Viewport3D>
            </Border>
            <StackPanel Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock Text="{Binding FrameText}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="Badge" Text="{Binding BadgeText}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding CheckText}" Foreground="#FF9FB4CC" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Force table -->
            <Border Grid.Row="1" Background="#FF181C22" BorderBrush="#FF2F3642" BorderThickness="0,1,0,0" Padding="12,8">
                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="140" /><ColumnDefinition Width="115" />
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="115" /><ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cylinder" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="1" Text="Source" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="2" Text="Newton per m" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="3" Text="GR factor" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="4" Text="Per frame metre" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="5" Text="Per proper metre (÷γ)" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="6" Text="Overlap" Foreground="#FF8FA3BF" />
                        <TextBlock Grid.Column="7" Text="Total in frame" Foreground="#FF8FA3BF" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="   " />
                                        <Run Text="{Binding Speed, Mode=OneWay}" />
                                        <Run Text="   " />
                                        <Run Text="{Binding Gamma, Mode=OneWay}" />
                                        <Run Text="   length " />
                                        <Run Text="{Binding Length, Mode=OneWay}" />
                                        <Run Text="   net " />
                                        <Run Text="{Binding NetPerMetre, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding NetTotal, Mode=OneWay}" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Pairs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="140" /><ColumnDefinition Width="115" />
                                                        <ColumnDefinition Width="110" /><ColumnDefinition Width="115" /><ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="{Binding Source}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding NewtonianPerMetre}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Coupling}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding PerFrameMetre}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding PerElement}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Overlap}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding Total}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TableFootnote}" TextWrapping="Wrap" Foreground="#FF8FA3BF" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ModelHelpText}" TextWrapping="Wrap" Foreground="#FFB8C2D0" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SimultaneityNote}" TextWrapping="Wrap" Foreground="#FF8FA3BF" Margin="0,4,0,0" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
