<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GravityCylinders</RootNamespace>
    <AssemblyName>GravityCylinders</AssemblyName>
    <ApplicationIcon>Assets\GravityCylinders.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\GravityCylinders.ico" />
  </ItemGroup>

</Project>
